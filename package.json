{
  "name": "canon-clerk-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "dev": "vitest",
    "clean": "rm -rf node_modules packages/*/dist packages/*/node_modules",
    "bump": "npm version --workspaces --include-workspace-root",
    "typecheck": "npm run typecheck --workspaces"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^24.0.9",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
