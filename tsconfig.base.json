{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // Environment Settings
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Path aliases for monorepo development
    "paths": {
      "@canon-clerk/schema": ["./packages/schema/src/index.ts"],
      "@canon-clerk/core": ["./packages/core/src/index.ts"],
      "@canon-clerk/configuration": ["./packages/configuration/src/index.ts"]
    },

    // Type checking only; bundling and emits are managed by tsup
    "noEmit": true,

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
