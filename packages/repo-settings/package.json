{
  "name": "@canon-clerk/repo-settings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Declarative GitHub repository metadata validator and synchronization tool for Canon Clerk",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "repo-settings": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --clean",
    "dev": "tsup src/cli.ts src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "check": "node ./dist/cli.js check",
    "sync": "node ./dist/cli.js sync"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "license": "Apache-2.0"
}
