{
  "name": "@canon-clerk/configuration",
  "version": "0.1.0",
  "type": "module",
  "description": "Configuration resolution, environment cascading, and OS-level credential management for Canon Clerk",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@canon-clerk/core": "*",
    "conf": "^15.1.0",
    "env-paths": "^3.0.0"
  },
  "license": "Apache-2.0"
}
