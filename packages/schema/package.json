{
  "name": "@canon-clerk/schema",
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript types, schema definitions, and parser AST interfaces for Canon Clerk",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch"
  },
  "license": "Apache-2.0"
}
