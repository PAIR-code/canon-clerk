{
  "name": "@canon-clerk/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Core evaluation cascade, path filtering, and discovery engine for Canon Clerk",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@canon-clerk/schema": "*",
    "ignore": "^7.0.5"
  },
  "license": "Apache-2.0"
}
