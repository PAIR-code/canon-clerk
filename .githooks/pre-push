#!/bin/sh
set -e

# Skip checks when deleting remote branches
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$local_oid" = "0000000000000000000000000000000000000000" ] || [ -z "$local_oid" ]; then
    exit 0
  fi
done

# Run shift-left validation if in a package checkout
if [ -f package.json ]; then
  npm run check
fi
